{
  "name": "tukaka-database-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "dev:desktop": "concurrently -k \"pnpm --filter web dev -- --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron apps/desktop\""
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "wait-on": "^9.5.1"
  }
}
